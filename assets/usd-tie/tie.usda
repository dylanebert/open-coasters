#usda 1.0
(
    defaultPrim = "Tie"
    doc = "Blender v5.2.2 LTS"
    metersPerUnit = 0.01
    upAxis = "Z"
)

def Xform "Tie"
{
    float3 xformOp:rotateXYZ = (0, -0, 90)
    float3 xformOp:scale = (100, 100, 100)
    double3 xformOp:translate = (30.000001907348633, -20, 5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

    def Mesh "Bar" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        float3[] extent = [(0.02, -0.08, 0.03), (1.22, 0.12, 0.13)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        rel material:binding = </_materials/TieSteel>
        point3f[] points = [(0.02, -0.08, 0.03), (1.22, -0.08, 0.03), (1.12, 0.12, 0.03), (0.02, 0.12, 0.03), (0.02, -0.08, 0.13), (1.22, -0.08, 0.13), (1.12, 0.12, 0.13), (0.02, 0.12, 0.13)]
        uniform token subdivisionScheme = "none"
        float3 xformOp:rotateXYZ = (0, -0, -90)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.0599999874830246, 0.09000000357627869, 0.04000000283122063)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}

def Scope "_materials"
{
    def Material "TieSteel" (
        prepend apiSchemas = ["ColorSpaceAPI"]
    )
    {
        uniform token colorSpace:name = "lin_rec709_scene"
        token outputs:surface.connect = </_materials/TieSteel/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor = (0.125, 0.25, 0.5)
            float inputs:ior = 1.5
            float inputs:metallic = 0.75
            float inputs:opacity = 1
            float inputs:roughness = 0.375
            float inputs:specular = 0.5
            token outputs:surface
        }
    }
}

